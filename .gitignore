# Git ignore for SAR Workbench
# Data directories (do not commit datasets)
/CCD-CP-CoPol/
/Gotcha-CP-Disc2/
/MSTAR-Public*
/Sentinel1/
/p4b_runs/
/.venv/
/figures/

# MATLAB temp files & caches
*.asv
*.slxc
*.autosave
*.tmp
_write_test.tmp

# Local user configuration (do not commit local machine paths)
sarconfig.json
*.mat
!models/*.mat

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
